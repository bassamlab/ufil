<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file" default="$(find-pkg-share ufil_message_filter)/config/default.yaml"
    description="Parameters loaded on top of the package defaults, e.g. the area of interest."/>
  <arg name="namespace" default="" description="Namespace of the node."/>
  <arg name="node_name" default="object_list_position_filter" description="Name of the node."/>
  <arg name="input_topic" default="objects" description="Subscribed object lists."/>
  <arg name="output_topic" default="objects_filtered"
    description="Published object lists with the objects inside the area of interest."/>

  <node pkg="ufil_message_filter" exec="object_list_position_filter_node"
    name="$(var node_name)" namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ufil_message_filter)/config/default.yaml"/>
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="objects" to="$(var input_topic)"/>
    <remap from="objects_filtered" to="$(var output_topic)"/>
  </node>
</launch>
