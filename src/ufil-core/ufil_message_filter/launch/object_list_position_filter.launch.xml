<?xml version="1.0"?>
<!-- Starts the filter like default.launch.xml, with the area of interest given as launch argument
     and the argument names used by the ufil-examples launch files. -->
<launch>
  <arg name="object_list_position_filter_input_topic" default="objects"
    description="Subscribed object lists."/>
  <arg name="object_list_position_filter_output_topic" default="objects_filtered"
    description="Published object lists with the objects inside the area of interest."/>
  <arg name="object_list_position_filter_namespace" default="core"
    description="Namespace of the node."/>
  <arg name="object_list_position_filter_use_sim_time" default="true"
    description="Use the /clock topic as time source."/>
  <arg name="object_list_position_filter_area_of_interest"
    description="Vertices of the area of interest [x1, y1, x2, y2, ...] [m] in the frame of the input object lists."/>
  <arg name="object_list_position_filter_node_name" default="object_list_position_filter"
    description="Object list position filter node name."/>

  <node pkg="ufil_message_filter" exec="object_list_position_filter_node"
    name="$(var object_list_position_filter_node_name)"
    namespace="$(var object_list_position_filter_namespace)" output="screen">
    <param from="$(find-pkg-share ufil_message_filter)/config/default.yaml"/>
    <param name="area_of_interest.enabled" value="true"/>
    <param name="area_of_interest.vertices"
      value="$(var object_list_position_filter_area_of_interest)"/>
    <param name="use_sim_time" value="$(var object_list_position_filter_use_sim_time)"/>
    <remap from="objects" to="$(var object_list_position_filter_input_topic)"/>
    <remap from="objects_filtered" to="$(var object_list_position_filter_output_topic)"/>
  </node>
</launch>
