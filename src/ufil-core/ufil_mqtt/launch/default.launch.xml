<?xml version="1.0"?>
<launch>
  <!-- The defaults of the converter arguments are the ones of config/default.yaml. -->
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="namespace" default="" description="Namespace of the node."/>
  <arg name="node_name" default="mqtt_message_converter" description="Name of the node."/>
  <arg name="input_topic" default="/lab/groundtruth" description="ROS 2 topic that is forwarded."/>
  <arg name="message_type" default="object_list"
    description="Message type of input_topic: object_list or occupancy_grid."/>
  <arg name="broker_protocol" default="tcp" description="Transport to the broker: tcp or ssl."/>
  <arg name="broker_host" default="localhost" description="Host of the MQTT broker."/>
  <arg name="broker_port" default="1883" description="Port of the MQTT broker."/>
  <arg name="client_id" default="" description="MQTT client ID, empty: the node name."/>
  <arg name="mqtt_topic" default="ufil/object_list" description="MQTT topic to publish on."/>

  <node pkg="ufil_mqtt" exec="mqtt_message_converter_node" name="$(var node_name)"
    namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ufil_mqtt)/config/default.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="message_type" value="$(var message_type)"/>
    <param name="broker.protocol" value="$(var broker_protocol)"/>
    <param name="broker.host" value="$(var broker_host)"/>
    <param name="broker.port" value="$(var broker_port)"/>
    <param name="broker.client_id" value="$(var client_id)"/>
    <param name="mqtt_topic" value="$(var mqtt_topic)"/>
    <remap from="input" to="$(var input_topic)"/>
  </node>
</launch>
