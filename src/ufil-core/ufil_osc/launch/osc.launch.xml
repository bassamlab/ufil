<?xml version="1.0"?>
<!-- Kept for compatibility, the arguments are passed on to default.launch.xml. -->
<launch>
  <arg name="osc_use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="osc_namespace" default="" description="Namespace of the OSC converter node."/>
  <arg name="osc_node_name" default="osc_message_converter_node"
    description="Name of the OSC converter node."/>
  <arg name="osc_host" default="127.0.0.1" description="Host of the OSC receiver."/>
  <arg name="osc_port" default="9000" description="UDP port of the OSC receiver."/>
  <arg name="osc_source_topic" default="/lab/groundtruth" description="ROS 2 topic to forward."/>
  <arg name="osc_address" default="/objects" description="OSC address of the messages."/>
  <arg name="osc_message_type" default="object_list"
    description="Message type of osc_source_topic: object_list or occupancy_grid."/>

  <include file="$(find-pkg-share ufil_osc)/launch/default.launch.xml">
    <arg name="use_sim_time" value="$(var osc_use_sim_time)"/>
    <arg name="namespace" value="$(var osc_namespace)"/>
    <arg name="node_name" value="$(var osc_node_name)"/>
    <arg name="input_topic" value="$(var osc_source_topic)"/>
    <arg name="message_type" value="$(var osc_message_type)"/>
    <arg name="receiver_host" value="$(var osc_host)"/>
    <arg name="receiver_port" value="$(var osc_port)"/>
    <arg name="osc_address" value="$(var osc_address)"/>
  </include>
</launch>
