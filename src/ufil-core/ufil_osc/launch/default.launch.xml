<?xml version="1.0"?>
<launch>
  <!-- The defaults of the converter arguments are the ones of config/default.yaml. -->
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="namespace" default="" description="Namespace of the node."/>
  <arg name="node_name" default="osc_message_converter" description="Name of the node."/>
  <arg name="input_topic" default="/lab/groundtruth" description="ROS 2 topic that is forwarded."/>
  <arg name="message_type" default="object_list"
    description="Message type of input_topic: object_list or occupancy_grid."/>
  <arg name="receiver_host" default="127.0.0.1" description="Host of the OSC receiver."/>
  <arg name="receiver_port" default="9000" description="UDP port of the OSC receiver."/>
  <arg name="osc_address" default="/objects" description="OSC address of the messages."/>

  <node pkg="ufil_osc" exec="osc_message_converter_node" name="$(var node_name)"
    namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ufil_osc)/config/default.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="message_type" value="$(var message_type)"/>
    <param name="receiver.host" value="$(var receiver_host)"/>
    <param name="receiver.port" value="$(var receiver_port)"/>
    <param name="osc_address" value="$(var osc_address)"/>
    <remap from="input" to="$(var input_topic)"/>
  </node>
</launch>
