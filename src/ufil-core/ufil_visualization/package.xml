<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>ufil_visualization</name>
    <version>0.1.0</version>
    <description>A ROS node that converts ufil_msgs/ObjectList messages into MarkerArray visualizations.</description>
    <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schaefer</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>ufil_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>rclcpp</depend>
    <depend>std_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>visualization_msgs</depend>
    <depend>lanelet2_core</depend>
    <depend>lanelet2_io</depend>
    <depend>lanelet2_projection</depend>
    <depend>boost</depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>