<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_visualization</name>
  <version>0.2.0</version>
  <description>
    Visualization of UFIL data as visualization_msgs/MarkerArray for Foxglove or Lichtblick: Lanelet2
    maps (lanelets, crosswalks, road markings, areas) and ufil_msgs/ObjectList (boxes, velocity,
    covariance ellipses, labels). Provides a ROS-independent core library that builds the marker
    geometry and the ROS 2 components ufil_visualization::LaneletMapMarkerArrayNode and
    ufil_visualization::ObjectListMarkerArrayNode.
  </description>
  <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schäfer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <!-- Core library -->
  <build_depend>boost</build_depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>lanelet2_projection</depend>

  <!-- ROS 2 components -->
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>ufil_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>class_loader</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
