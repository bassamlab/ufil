<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_etsi</name>
  <version>0.1.0</version>
  <description>Converts standard ROS2 messages to ROS2-based ETSI ITS messages.</description>
  <maintainer email="hegerath@embedded.rwth-aachen.de">Lucas Hegerath</maintainer>
  <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schäfer</maintainer>
  <license>MIT</license>

  <depend>eigen</depend>
  <depend>etsi_its_msgs</depend>
  <depend>etsi_its_msgs_utils</depend>
  <depend>geographiclib</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ufil_msgs</depend>
  <depend>ufil_ros</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
      <build_type>ament_cmake</build_type>
  </export>
</package>
