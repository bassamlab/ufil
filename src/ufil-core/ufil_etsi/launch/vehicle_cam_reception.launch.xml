<?xml version="1.0"?>
<!--
  Compatibility launch file with prefixed arguments (used by ufil_rsu/launch/cam.launch.xml).
  Starts the vehicle CAM receiver like vehicle_cam_receiver.launch.xml.
-->
<launch>
  <arg name="vehicle_cam_receiver_use_sim_time" default="true" description="Use the /clock topic as time source." />
  <arg name="vehicle_cam_receiver_namespace" default="" description="Namespace for the vehicle CAM receiver node." />
  <arg name="vehicle_cam_receiver_node_name" default="vehicle_cam_receiver_node" description="Vehicle CAM receiver node name." />
  <arg name="vehicle_cam_receiver_input_topic" default="cam" description="Cam input topic name" />
  <arg name="vehicle_cam_receiver_output_topic" default="object_list" description="Object output topic name" />
  <arg name="vehicle_cam_receiver_time_shift_nanosec" default="0" description="Shift of the ROS time for the ETSI timestamps [ns], ITS time starts in 2004." />
  <arg name="vehicle_cam_receiver_target_frame" default="map" description="Frame the objects are published in." />

  <node pkg="ufil_etsi" exec="vehicle_cam_receiver_node" name="$(var vehicle_cam_receiver_node_name)" namespace="$(var vehicle_cam_receiver_namespace)" output="screen">
    <param from="$(find-pkg-share ufil_etsi)/config/vehicle_cam_receiver.yaml" />
    <param name="use_sim_time" value="$(var vehicle_cam_receiver_use_sim_time)" />
    <param name="time_shift_nanosec" value="$(var vehicle_cam_receiver_time_shift_nanosec)" />
    <param name="target_frame" value="$(var vehicle_cam_receiver_target_frame)" />
    <remap from="cam" to="$(var vehicle_cam_receiver_input_topic)" />
    <remap from="object_list" to="$(var vehicle_cam_receiver_output_topic)" />
  </node>
</launch>
