<?xml version="1.0"?>
<launch>
  <arg name="vehicle_cam_receiver_use_sim_time" default="true" description="Flag indicating that a recorded file is used." />
  <arg name="vehicle_cam_receiver_namespace" default="" description="Namespace for the vehicle CAM receiver node." />
  <arg name="vehicle_cam_receiver_node_name" default="vehicle_cam_receiver_node" description="Vehicle CAM receiver node name." />
  <arg name="vehicle_cam_receiver_input_topic" default="cam" description="Cam input topic name" />
  <arg name="vehicle_cam_receiver_output_topic" default="/obu/objects" description="Object output topic name" />
  <arg name="vehicle_cam_receiver_time_shift_nanosec" default="0" description="Time Shift for cam messages as they need to start at 2004" />
  <arg name="vehicle_cam_receiver_enable_stats" default="false" description="Enable packet forwarding statistics" />
  <arg name="vehicle_cam_receiver_target_frame" default="map" description="Target frame of final; transform" />

  <node pkg="ufil_etsi" exec="vehicle_cam_receiver_node" name="$(var vehicle_cam_receiver_node_name)" namespace="$(var vehicle_cam_receiver_namespace)" output="screen">
    <param name="use_sim_time" value="$(var vehicle_cam_receiver_use_sim_time)" />
    <param name="enable_stats" value="$(var vehicle_cam_receiver_enable_stats)" />
    <param name="time_shift_nanosec" value="$(var vehicle_cam_receiver_time_shift_nanosec)" />
    <param name="target_frame" value="$(var vehicle_cam_receiver_target_frame)" />
    <remap from="cam" to="$(var vehicle_cam_receiver_input_topic)" />
    <remap from="objects" to="$(var vehicle_cam_receiver_output_topic)" />
  </node>
</launch>