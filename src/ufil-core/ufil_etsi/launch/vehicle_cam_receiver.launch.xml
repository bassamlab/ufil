<?xml version="1.0"?>
<!-- Converts received vehicle CAMs into UFIL objects. -->
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file" default="$(find-pkg-share ufil_etsi)/config/vehicle_cam_receiver.yaml"
    description="Parameters loaded on top of the package defaults."/>
  <arg name="namespace" default="" description="Namespace of the node."/>
  <arg name="node_name" default="vehicle_cam_receiver_node" description="Name of the node."/>
  <arg name="input_topic" default="cam" description="Received CAMs."/>
  <arg name="output_topic" default="object_list" description="Objects of the received CAMs."/>

  <node pkg="ufil_etsi" exec="vehicle_cam_receiver_node" name="$(var node_name)"
    namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ufil_etsi)/config/vehicle_cam_receiver.yaml"/>
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="cam" to="$(var input_topic)"/>
    <remap from="object_list" to="$(var output_topic)"/>
  </node>
</launch>
