<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>ufil_object_tracking</name>
    <version>0.2.0</version>
    <description>
      Header-only, ROS-independent C++ library for multi-object tracking: state, dimension,
      classification and existence types, transition and measurement models, association,
      track management and updaters.
    </description>
    <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schäfer</maintainer>
    <license>MIT</license>

    <depend>eigen</depend>
    <depend>tbb</depend>
    <depend>boost</depend>
    <depend>libpcl-all-dev</depend>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>
    <test_depend>ament_cmake_gtest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
