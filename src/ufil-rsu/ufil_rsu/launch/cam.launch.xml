<?xml version="1.0"?>
<!--
  Receives ETSI CAMs via UDP and publishes them as UFIL objects in <namespace>/cam/<output_topic>.
-->
<launch>
  <!-- Declare launch arguments -->
  <arg name="namespace" default="rsu" description="Namespace of this node." />
  <arg name="listen_port" default="5000" description="Listening port number" />
  <arg name="output_topic" default="object_list" description="Objects of the received CAMs." />
  <arg name="time_shift_nanosec" default="0" description="Time Shift for cam messages as they need to start at 2004" />
  <arg name="enable_stats" default="false" description="Enable packet forwarding statistics" />
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source." />
  <arg name="target_frame" default="map" description="Target frame of the cam converter." />

  <!-- Group actions with namespace -->
  <group>
    <push-ros-namespace namespace="$(var namespace)"/>
    <group>
      <push-ros-namespace namespace="cam"/>
      <!-- Include vehicle_cam_reception.launch.xml -->
      <include file="$(find-pkg-share ufil_etsi)/launch/vehicle_cam_reception.launch.xml">
        <arg name="vehicle_cam_receiver_time_shift_nanosec" value="$(var time_shift_nanosec)" />
        <arg name="vehicle_cam_receiver_input_topic" value="cam" />
        <arg name="vehicle_cam_receiver_output_topic" value="$(var output_topic)" />
        <arg name="vehicle_cam_receiver_use_sim_time" value="$(var use_sim_time)" />
        <arg name="vehicle_cam_receiver_target_frame" value="$(var target_frame)" />
      </include>

      <!-- Start etsi_its_conversion_node -->
      <node pkg="etsi_its_conversion" exec="etsi_its_conversion_node" name="etsi_its_conversion_node" output="screen">
        <param name="udp2ros_etsi_types" value="['cam']" />
        <param name="ros2udp_etsi_types" value="['']" />
        <param name="has_btp_destination_port" value="true" />
        <param name="btp_destination_port_offset" value="0" />
        <param name="etsi_message_payload_offset" value="4" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <remap from="etsi_its_conversion_node/cam/out" to="cam" />
        <remap from="etsi_its_conversion_node/udp/in" to="udp" />
      </node>

      <!-- Include udp_receiver.launch.xml -->
      <include file="$(find-pkg-share ufil_udp)/launch/udp_receiver.launch.xml">
        <arg name="udp_receiver_output_topic" value="udp" />
        <arg name="udp_receiver_listen_port" value="$(var listen_port)" />
        <arg name="udp_receiver_enable_stats" value="$(var enable_stats)" />
        <arg name="udp_receiver_use_sim_time" value="$(var use_sim_time)" />
      </include>
    </group>
  </group>
</launch>
