<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file" default="$(find-pkg-share ufil_central_fusion)/config/default.yaml"
    description="Parameters loaded on top of the package defaults."/>
  <arg name="namespace" default="rsu" description="Namespace of the node."/>
  <arg name="output_topic" default="object_list" description="Published fused objects."/>

  <node pkg="ufil_central_fusion" exec="central_fusion_node" name="central_fusion"
    namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ufil_central_fusion)/config/default.yaml"/>
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="object_list" to="$(var output_topic)"/>
  </node>
</launch>
