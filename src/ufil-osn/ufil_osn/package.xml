<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_osn</name>
  <version>0.2.0</version>
  <description>
    Meta package of the UFIL outdoor sensor node (OSN). Provides the launch file composing the
    point cloud preprocessor and the object tracker into one processing pipeline.
  </description>
  <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schäfer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>ufil_osn_tracker</exec_depend>
  <exec_depend>ufil_pcl_preprocessor</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>tf2_ros</test_depend>
  <test_depend>ufil_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
