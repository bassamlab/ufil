<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_obu</name>
  <version>0.2.0</version>
  <description>
    Meta package of the UFIL on-board unit (OBU). Provides the launch files for the state
    estimation of the own vehicle (robot_localization and object aggregation) and for sending
    the vehicle's objects as ETSI CAM via UDP.
  </description>
  <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schäfer</maintainer>
  <license>MIT</license>
  <author email="hegerath@embedded.rwth-aachen.de">Lucas Hegerath</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>etsi_its_conversion</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>ufil_etsi</exec_depend>
  <exec_depend>ufil_obu_object_aggregation</exec_depend>
  <exec_depend>ufil_udp</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>ufil_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
