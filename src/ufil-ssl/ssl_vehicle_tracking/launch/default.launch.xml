<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file" default="$(find-pkg-share ssl_vehicle_tracking)/config/default.yaml"
    description="Parameters loaded on top of the package defaults."/>
  <arg name="namespace" default="ssl" description="Namespace of the node."/>
  <arg name="input_topic" default="wheel_tracks" description="Wheel tracks."/>
  <arg name="output_topic" default="vehicles" description="Published vehicles."/>

  <node pkg="ssl_vehicle_tracking" exec="ssl_vehicle_tracking_node" name="ssl_vehicle_tracking"
    namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ssl_vehicle_tracking)/config/default.yaml"/>
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="wheel_tracks" to="$(var input_topic)"/>
    <remap from="vehicles" to="$(var output_topic)"/>
  </node>
</launch>
