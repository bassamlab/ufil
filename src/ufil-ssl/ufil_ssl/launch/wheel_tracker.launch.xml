<?xml version="1.0"?>
<launch>
  <!-- Declare launch arguments -->
  <arg name="wheel_tracker_base_namespace" default="ssl"/>
  <arg name="wheel_tracker_use_sim_time" default="true"/>
  <arg name="wheel_tracker_input_topics" default="['ssl_1/map']"/>
  <arg name="wheel_tracker_output_topic" default="wheel_tracks"/>

  <!-- Wheel detection and tracking of all mats -->
  <group>
    <push-ros-namespace namespace="$(var wheel_tracker_base_namespace)"/>
    <node
      pkg="ssl_wheel_tracker"
      exec="ssl_wheel_tracker_node"
      name="ssl_wheel_tracker"
      output="screen">
      <param from="$(find-pkg-share ssl_wheel_tracker)/config/default.yaml"/>
      <param name="use_sim_time" value="$(var wheel_tracker_use_sim_time)" />
      <param name="input_topics" value="$(var wheel_tracker_input_topics)" />
      <remap from="wheel_tracks" to="$(var wheel_tracker_output_topic)"/>
    </node>
  </group>
</launch>
