<?xml version="1.0"?>
<launch>
  <!-- Declare launch arguments -->
  <arg name="vehicle_tracking_base_namespace" default="ssl"/>
  <arg name="vehicle_tracking_use_sim_time" default="true"/>
  <arg name="vehicle_tracking_input_topic" default="wheel_tracks"/>
  <arg name="vehicle_tracking_output_topic" default="vehicle_tracks"/>
  <arg name="vehicle_tracking_vehicle_templates" default="['muCar_scaled_lab.json']"/>

  <!-- Vehicle detection and tracking from the wheel tracks -->
  <group>
    <push-ros-namespace namespace="$(var vehicle_tracking_base_namespace)"/>
    <node
      pkg="ssl_vehicle_tracking"
      exec="ssl_vehicle_tracking_node"
      name="ssl_vehicle_tracking"
      output="screen">
      <param from="$(find-pkg-share ssl_vehicle_tracking)/config/default.yaml"/>
      <param name="use_sim_time" value="$(var vehicle_tracking_use_sim_time)" />
      <param name="vehicle_templates" value="$(var vehicle_tracking_vehicle_templates)" />
      <remap from="wheel_tracks" to="$(var vehicle_tracking_input_topic)"/>
      <remap from="vehicles" to="$(var vehicle_tracking_output_topic)"/>
    </node>
  </group>
</launch>
