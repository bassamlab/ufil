<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file" default="$(find-pkg-share ssl_simulator)/config/default.yaml"
    description="Parameters loaded on top of the package defaults."/>
  <arg name="namespace" default="ssl" description="Namespace of the node."/>
  <arg name="input_topic" default="object_list" description="Object list of the vehicles."/>

  <node pkg="ssl_simulator" exec="ssl_simulator_node" name="ssl_simulator"
    namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ssl_simulator)/config/default.yaml"/>
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="object_list" to="$(var input_topic)"/>
  </node>
</launch>
