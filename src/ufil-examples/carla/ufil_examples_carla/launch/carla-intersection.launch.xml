<?xml version="1.0"?>
<!--
  CARLA intersection example on a single machine: head and headless with the overrides of
  config/carla-intersection_local.yaml (the CAMs are sent to the local RSU).
-->
<launch>
  <arg name="use_sim_time" default="true"
    description="Use the /clock topic of the CARLA ROS bridge."/>
  <arg name="params_file"
    default="$(find-pkg-share ufil_examples_carla)/config/carla-intersection.yaml"
    description="Parameters of all nodes."/>
  <arg name="local_params_file"
    default="$(find-pkg-share ufil_examples_carla)/config/carla-intersection_local.yaml"
    description="Single-machine overrides of params_file."/>

  <include file="$(find-pkg-share ufil_examples_carla)/launch/carla-intersection_head.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="params_file" value="$(var params_file)"/>
    <arg name="local_params_file" value="$(var local_params_file)"/>
  </include>
  <include file="$(find-pkg-share ufil_examples_carla)/launch/carla-intersection_headless.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="params_file" value="$(var params_file)"/>
    <arg name="local_params_file" value="$(var local_params_file)"/>
  </include>
</launch>
