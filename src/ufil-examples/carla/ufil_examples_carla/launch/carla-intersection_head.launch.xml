<launch>
  <!-- Declare launch arguments -->
  <arg name="use_sim_time" default="true"
    description="Flag indicating that a recorded file is used." />
  <arg name="enable_stats" default="false" description="Enable packet forwarding statistics" />

  <!-- Include visualization bridge -->
  <include file="$(find-pkg-share ufil_examples_carla)/launch/bridge.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)" />
    <arg name="enable_stats" value="$(var enable_stats)" />
  </include>

  <include file="$(find-pkg-share ufil_visualization)/launch/object_list_marker_array.launch.xml">
    <arg name="object_list_marker_array_use_sim_time" value="$(var object_list_marker_array_use_sim_time)" />
    <arg name="object_list_marker_array_input_topic" value="/obu/object_list" />
    <arg name="object_list_marker_array_output_topic" value="/obu/object_markers" />
    <arg name="object_list_marker_array_node_name" value="object_list_marker_array_obu" />
  </include>

  <include file="$(find-pkg-share ufil_visualization)/launch/object_list_marker_array.launch.xml">
    <arg name="object_list_marker_array_use_sim_time" value="$(var object_list_marker_array_use_sim_time)" />
    <arg name="object_list_marker_array_input_topic" value="/osn/object_list" />
    <arg name="object_list_marker_array_output_topic" value="/osn/object_markers" />
    <arg name="object_list_marker_array_node_name" value="object_list_marker_array_osn" />
  </include>

  <include file="$(find-pkg-share ufil_visualization)/launch/object_list_marker_array.launch.xml">
    <arg name="object_list_marker_array_use_sim_time" value="$(var object_list_marker_array_use_sim_time)" />
    <arg name="object_list_marker_array_input_topic" value="/rsu/object_list" />
    <arg name="object_list_marker_array_output_topic" value="/rsu/object_markers" />
    <arg name="object_list_marker_array_node_name" value="object_list_marker_array_rsu" />
  </include>

  <include file="$(find-pkg-share ufil_visualization)/launch/object_list_marker_array.launch.xml">
    <arg name="object_list_marker_array_use_sim_time" value="$(var object_list_marker_array_use_sim_time)" />
    <arg name="object_list_marker_array_input_topic" value="/rsu/cam/object_list" />
    <arg name="object_list_marker_array_output_topic" value="/rsu/cam/object_markers" />
    <arg name="object_list_marker_array_node_name" value="object_list_marker_array_rsu_cam" />
  </include>

  <!-- Include OBU -->
  <include file="$(find-pkg-share ufil_examples_carla)/launch/obu.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)" />
    <arg name="enable_stats" value="$(var enable_stats)" />
    <arg name="obu_target_ip" value="192.168.1.41" />
    <arg name="object_list_position_filter_area_of_interest" value="[180.0, -10.5, 180.0, 70.5, 220.0, 70.5, 220.0, -10.5]" />
  </include>
</launch>