    <arg name="base_namespace" value="obu_2" />
    <arg name="use_sim_time" value="$(var use_sim_time)" />
    <arg name="enable_stats" value="$(var enable_stats)" />
    <arg name="cam_time_shift_nanosec" value="1104537600000000000" />
    <arg name="input_topic" value="/obu/object_list" />
    <arg name="obu_target_frame" value="utm_32n" />
    <arg name="object_array_index" value="2" />
    <arg name="target_ip" value="$(var obu_target_ip)" />
  </include>

  <!-- OBU 3 launch -->
  <include file="$(find-pkg-share ufil_obu)/launch/default.launch.py">
    <arg name="base_namespace" value="obu_3" />
    <arg name="use_sim_time" value="$(var use_sim_time)" />
    <arg name="enable_stats" value="$(var enable_stats)" />
    <arg name="cam_time_shift_nanosec" value="1104537600000000000" />
    <arg name="input_topic" value="/obu/object_list" />
    <arg name="obu_target_frame" value="utm_32n" />
    <arg name="object_array_index" value="3" />
    <arg name="target_ip" value="$(var obu_target_ip)" />
  </include>

