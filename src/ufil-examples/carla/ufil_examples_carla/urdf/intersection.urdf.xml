<?xml version="1.0"?>
<robot name="carla-intersection">
  <link name="map"></link>
  <link name="sensor_node_base"></link>
  <link name="sensor_node"></link>
  <link name="lidar"></link>
  <link name="aoi1"></link>
  <link name="aoi2"></link>
  <link name="aoi3"></link>
  <link name="aoi4"></link>

  <joint name="map_to_sensor_node_base" type="fixed">
    <parent link="map" />
    <child link="sensor_node_base" />
    <origin xyz="-58.8 -145.5 0" rpy="0 0 1.31" />
  </joint>

  <joint name="sensor_node_base_to_sensor_node" type="fixed">
    <parent link="sensor_node_base"/>
    <child link="sensor_node"/>
    <origin xyz="0 0 6.5" rpy="0 0 0"/>
  </joint>

  <joint name="sensor_node_to_lidar" type="fixed">
    <parent link="sensor_node"/>
    <child link="lidar"/>
    <origin xyz="0 0 0" rpy="-3.141592654 0.436332313 0.0"/>
  </joint>

  <joint name="map_to_aoi1" type="fixed">
    <parent link="map" />
    <child link="aoi1" />
    <origin xyz="-90.0 -150.0 0.0" rpy="0 0 0" />
  </joint>

  <joint name="map_to_aoi2" type="fixed">
    <parent link="map" />
    <child link="aoi2" />
    <origin xyz="-90.0 -110.0 0.0" rpy="0 0 -1.570796327" />
  </joint>

  <joint name="map_to_aoi3" type="fixed">
    <parent link="map" />
    <child link="aoi3" />
    <origin xyz="-5.0 -110.0 0.0" rpy="0 0 3.141592654" />
  </joint>

  <joint name="map_to_aoi4" type="fixed">
    <parent link="map" />
    <child link="aoi4" />
    <origin xyz="-5.0 -150.0 0.0" rpy="0 0 1.570796327" />
  </joint>
</robot>