<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file"
    default="$(find-pkg-share ufil_examples_carla_adapter)/config/default.yaml"
    description="Parameters loaded on top of the package defaults."/>
  <arg name="namespace" default="" description="Namespace of the node."/>
  <arg name="node_name" default="carla_adapter" description="Name of the node."/>
  <arg name="objects_topic" default="/carla/objects"
    description="Ground-truth objects of the CARLA ROS bridge."/>
  <arg name="actor_list_topic" default="/carla/actor_list"
    description="Actor list of the CARLA ROS bridge."/>
  <arg name="output_topic" default="object_list" description="Published object lists."/>

  <node pkg="ufil_examples_carla_adapter" exec="ufil_examples_carla_adapter_node"
    name="$(var node_name)" namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ufil_examples_carla_adapter)/config/default.yaml"/>
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="objects" to="$(var objects_topic)"/>
    <remap from="actor_list" to="$(var actor_list_topic)"/>
    <remap from="object_list" to="$(var output_topic)"/>
  </node>
</launch>
