<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_examples_carla_adapter</name>
  <version>0.0.0</version>
  <description>Package to translate CARLA msgs into Ufil objects.</description>
  <maintainer email="priegnitz@embedded.rwth-aachen.de">cpm</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <depend>ament_cmake</depend>
  <depend>carla_msgs</depend>
  <depend>derived_object_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ufil_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ufil_ros</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>boost</depend>
  <depend>tf2_geometry_msgs</depend>
  <build_depend>rosidl_default_generators</build_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
