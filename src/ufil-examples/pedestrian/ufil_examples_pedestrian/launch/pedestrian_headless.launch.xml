<?xml version="1.0"?>
<!--
  Headless machine of the pedestrian example: the simulator publishes the ground truth and the
  noisy detections of a scenario in /ufil_examples_pedestrian, the tracker of the outdoor sensor
  node tracks the detections and publishes /osn/object_list.
  All parameters are in config/pedestrian.yaml.
-->
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file"
    default="$(find-pkg-share ufil_examples_pedestrian)/config/pedestrian.yaml"
    description="Parameters of all nodes."/>
  <arg name="local_params_file" default="$(var params_file)"
    description="Machine-specific overrides of params_file."/>
  <arg name="scenario" default="crossing.yaml"
    description="Scenario file name in the config directory of ufil_examples_pedestrian_simulator (appearing.yaml, clutter.yaml, crossing.yaml, crowd.yaml, group.yaml, occlusion.yaml, overtaking.yaml, parallel.yaml, passing.yaml, waiting.yaml) or an absolute path."/>

  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <node pkg="ufil_examples_pedestrian_simulator" exec="ufil_examples_pedestrian_simulator_node"
    name="pedestrian_simulator" namespace="ufil_examples_pedestrian" output="screen">
    <param from="$(find-pkg-share ufil_examples_pedestrian_simulator)/config/default.yaml"/>
    <param from="$(var params_file)" allow_substs="true"/>
    <param from="$(var local_params_file)" allow_substs="true"/>
    <param name="scenario_file" value="$(var scenario)"/>
  </node>

  <node pkg="ufil_examples_pedestrian_tracker" exec="ufil_examples_pedestrian_tracker_node"
    name="pedestrian_tracker" namespace="osn" output="screen">
    <param from="$(find-pkg-share ufil_examples_pedestrian_tracker)/config/default.yaml"/>
    <param from="$(var params_file)" allow_substs="true"/>
    <param from="$(var local_params_file)" allow_substs="true"/>
    <remap from="measured_objects" to="/ufil_examples_pedestrian/measured_objects"/>
    <remap from="tracked_objects" to="object_list"/>
  </node>
</launch>
