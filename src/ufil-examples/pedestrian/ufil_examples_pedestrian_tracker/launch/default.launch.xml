<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file"
    default="$(find-pkg-share ufil_examples_pedestrian_tracker)/config/default.yaml"
    description="Parameters loaded on top of the package defaults."/>
  <arg name="namespace" default="osn" description="Namespace of the node."/>
  <arg name="input_topic" default="/ufil_examples_pedestrian/measured_objects"
    description="Subscribed detected objects."/>
  <arg name="output_topic" default="object_list" description="Published tracked objects."/>

  <node pkg="ufil_examples_pedestrian_tracker" exec="ufil_examples_pedestrian_tracker_node"
    name="pedestrian_tracker" namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ufil_examples_pedestrian_tracker)/config/default.yaml"/>
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="measured_objects" to="$(var input_topic)"/>
    <remap from="tracked_objects" to="$(var output_topic)"/>
  </node>
</launch>
