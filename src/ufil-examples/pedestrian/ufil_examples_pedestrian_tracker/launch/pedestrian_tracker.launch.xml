<?xml version="1.0"?>
<!--
  Compatibility wrapper around default.launch.xml with the former prefixed argument names. The
  group keeps the arguments of default.launch.xml from leaking into the including launch file.
-->
<launch>
  <arg name="pedestrian_tracker_use_sim_time" default="false"
    description="Use the /clock topic as time source."/>
  <arg name="pedestrian_tracker_namespace" default="osn"
    description="Namespace of the tracker node."/>
  <arg name="pedestrian_tracker_input_topic" default="/ufil_examples_pedestrian/measured_objects"
    description="Input topic with measured objects."/>
  <arg name="pedestrian_tracker_output_topic" default="object_list"
    description="Output topic with tracked objects."/>

  <group>
    <include file="$(find-pkg-share ufil_examples_pedestrian_tracker)/launch/default.launch.xml">
      <arg name="use_sim_time" value="$(var pedestrian_tracker_use_sim_time)"/>
      <arg name="namespace" value="$(var pedestrian_tracker_namespace)"/>
      <arg name="input_topic" value="$(var pedestrian_tracker_input_topic)"/>
      <arg name="output_topic" value="$(var pedestrian_tracker_output_topic)"/>
    </include>
  </group>
</launch>
