<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_examples</name>
  <version>0.2.0</version>
  <description>
    Meta package of the UFIL examples: installs the bringup packages of the CARLA highway,
    CPM Lab and pedestrian examples together with everything they launch.
  </description>
  <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schäfer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ufil_examples_carla</exec_depend>
  <exec_depend>ufil_examples_cpm_lab</exec_depend>
  <exec_depend>ufil_examples_pedestrian</exec_depend>
  <!--
    ufil_examples_uofa is deliberately not listed: the uofa/ folder is removed from the public
    GitHub mirror of the workspace, where the dependency could not be resolved. Build it with the
    workspace target "make example_uofa".
  -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
