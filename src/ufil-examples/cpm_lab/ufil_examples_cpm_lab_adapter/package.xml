<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_examples_cpm_lab_adapter</name>
  <version>0.2.0</version>
  <description>Converts cpm lab mesasge into Ufil compatible data format.</description>
  <maintainer email="schaefer@embeddded.rwth-aachen.de">Simon Schäfer</maintainer>
  <license>mit</license>

  <depend>eigen</depend>
  <depend>geographiclib</depend>
  <depend>cpm_lab_lab_msgs</depend>
  <depend>cpm_lab_map_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ufil_msgs</depend>
  <depend>ufil_ros</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <!-- <depend>liboscpack-dev</depend> -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
