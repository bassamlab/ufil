<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_examples_cpm_lab_adapter</name>
  <version>0.2.0</version>
  <description>
    Connects the CPM Lab to UFIL. ROS 2 components publish the state of a lab vehicle as a UFIL
    object list (ufil_examples_cpm_lab_adapter::CpmLabAdapterNode), simulate its GNSS, IMU and
    wheel odometry (ufil_examples_cpm_lab_adapter::CpmLabSensorNode) and forward lane control
    light states as JSON in OSC messages (ufil_examples_cpm_lab_adapter::OscLaneControlLightNode).
    The scaling, sensor simulation and JSON encoding are a ROS-independent core library.
  </description>
  <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schäfer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <!-- Core library -->
  <depend>eigen</depend>
  <depend>geographiclib</depend>

  <!-- ROS 2 components -->
  <depend>builtin_interfaces</depend>
  <depend>cpm_lab_lab_msgs</depend>
  <depend>cpm_lab_map_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ufil_msgs</depend>
  <depend>ufil_object_tracking</depend>
  <depend>ufil_osc</depend>
  <depend>ufil_ros</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>class_loader</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
