<launch>
  <!-- Declare launch arguments -->
  <arg name="single_obu_use_sim_time" default="true" description="Flag indicating that a recorded file is used." />
  <arg name="single_obu_enable_stats" default="false" description="Enable packet forwarding statistics" />
  <arg name="single_obu_vehicle_id" default="0" description="ID of vehicle" />
  <arg name="single_obu_target_ip" default="127.0.0.1" />

  <!-- Adapter launch -->
  <include file="$(find-pkg-share ufil_examples_cpm_lab)/launch/cpm_lab_adapter.launch.xml">
    <arg name="cpm_lab_adapter_namespace" value="obu_$(var single_obu_vehicle_id)" />
    <arg name="cpm_lab_adapter_use_sim_time" value="$(var single_obu_use_sim_time)" />
    <arg name="cpm_lab_adapter_enable_stats" value="$(var single_obu_enable_stats)" />
    <arg name="cpm_lab_adapter_output_list_topic" value="object_list_unfiltered" />
    <arg name="cpm_lab_adapter_target_frame" value="map" />
    <arg name="cpm_lab_adapter_vehicle_id" value="$(var single_obu_vehicle_id)" />
  </include>

    <!-- Filter launch -->
  <include file="$(find-pkg-share ufil_message_filter)/launch/object_list_position_filter.launch.xml">
    <arg name="object_list_position_filter_namespace" value="obu_$(var single_obu_vehicle_id)" />
    <arg name="object_list_position_filter_use_sim_time" value="$(var single_obu_use_sim_time)" />
    <arg name="object_list_position_filter_enable_stats" value="$(var single_obu_enable_stats)" />
    <arg name="object_list_position_filter_input_topic" value="object_list_unfiltered" />
    <arg name="object_list_position_filter_output_topic" value="object_list" />
    <arg name="object_list_position_filter_area_of_interest" value="[81.0, 30.0, 81.0, 46.0, 0.0, 46.0, 0.0, 30.0]" />
  </include>

  <!-- OBU launch -->
  <include file="$(find-pkg-share ufil_obu)/launch/cam.launch.xml">
    <arg name="cam_namespace" value="obu_$(var single_obu_vehicle_id)" />
    <arg name="cam_use_sim_time" value="$(var single_obu_use_sim_time)" />
    <arg name="cam_enable_stats" value="$(var single_obu_enable_stats)" />
    <arg name="cam_time_shift_nanosec" value="500000000000" />
    <arg name="cam_input_topic" value="object_list" />
    <arg name="cam_target_frame" value="utm_32n" />
    <arg name="cam_target_ip" value="$(var single_obu_target_ip)" />
  </include>

</launch>
