    <arg name="single_obu_enable_stats" value="$(var obu_enable_stats)" />
    <arg name="single_obu_vehicle_id" value="12" />
    <arg name="single_obu_target_ip" value="$(var obu_target_ip)" />
  </include>

  <include file="$(find-pkg-share ufil_examples_cpm_lab)/launch/cpm_lab_adapter.launch.xml">
    <arg name="cpm_lab_adapter_namespace" value="obu" />
    <arg name="cpm_lab_adapter_use_sim_time" value="$(var obu_use_sim_time)" />
    <arg name="cpm_lab_adapter_enable_stats" value="$(var obu_enable_stats)" />
