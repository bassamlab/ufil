<launch>
  <!-- Declare launch arguments -->
  <arg name="obu_use_sim_time" default="true" description="Flag indicating that a recorded file is used." />
  <arg name="obu_enable_stats" default="false" description="Enable packet forwarding statistics" />
  <arg name="obu_target_ip" default="127.0.0.1" description="Target IP of RSU." />

  <!-- World Robot State Publisher -->
  <node
    pkg="robot_state_publisher"
    exec="robot_state_publisher"
    name="robot_state_publisher"
    namespace="obu"
    output="screen">
    <param name="use_sim_time" value="$(var obu_use_sim_time)" />
    <param name="robot_description" value="$(command 'cat $(find-pkg-share ufil_examples_cpm_lab)/urdf/utm_32n.urdf.xml')" />
  </node>

  <include file="$(find-pkg-share ufil_examples_cpm_lab)/launch/single_obu.launch.xml">
    <arg name="single_obu_use_sim_time" value="$(var obu_use_sim_time)" />
    <arg name="single_obu_enable_stats" value="$(var obu_enable_stats)" />
    <arg name="single_obu_vehicle_id" value="19" />
    <arg name="single_obu_target_ip" value="$(var obu_target_ip)" />
  </include>

    <include file="$(find-pkg-share ufil_examples_cpm_lab)/launch/single_obu.launch.xml">
    <arg name="single_obu_use_sim_time" value="$(var obu_use_sim_time)" />
    <arg name="single_obu_enable_stats" value="$(var obu_enable_stats)" />
    <arg name="single_obu_vehicle_id" value="18" />
    <arg name="single_obu_target_ip" value="$(var obu_target_ip)" />
  </include>

    <include file="$(find-pkg-share ufil_examples_cpm_lab)/launch/single_obu.launch.xml">
    <arg name="single_obu_use_sim_time" value="$(var obu_use_sim_time)" />
    <arg name="single_obu_enable_stats" value="$(var obu_enable_stats)" />
    <arg name="single_obu_vehicle_id" value="17" />
    <arg name="single_obu_target_ip" value="$(var obu_target_ip)" />
