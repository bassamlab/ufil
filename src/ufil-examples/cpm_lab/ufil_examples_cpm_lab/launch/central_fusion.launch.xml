<launch>
  <!-- Declare launch arguments -->
  <arg name="use_sim_time" default="true" description="Flag indicating that a recorded file is used." />
  <arg name="enable_stats" default="false" description="Enable packet forwarding statistics" />

  <!-- Central Fusion Include -->
  <include file="$(find-pkg-share ufil_rsu)/launch/central_fusion.launch.xml">
    <arg name="central_fusion_base_namespace" value="rsu" />
    <arg name="central_fusion_use_sim_time" value="$(var use_sim_time)" />
    <arg name="central_fusion_enable_stats" value="$(var enable_stats)" />
    <arg name="central_fusion_config_file" value="$(find-pkg-share ufil_examples_cpm_lab)/config/sfb_demonstrator_rsu.yaml" />
    <arg name="central_fusion_output_topic" value="object_list_unfiltered" />
  </include>

  <!-- Filter launch -->
  <include file="$(find-pkg-share ufil_message_filter)/launch/object_list_position_filter.launch.xml">
    <arg name="object_list_position_filter_namespace" value="rsu" />
    <arg name="object_list_position_filter_use_sim_time" value="$(var use_sim_time)" />
    <arg name="object_list_position_filter_enable_stats" value="$(var enable_stats)" />
    <arg name="object_list_position_filter_input_topic" value="object_list_unfiltered" />
    <arg name="object_list_position_filter_output_topic" value="object_list" />
    <arg name="object_list_position_filter_area_of_interest" value="[81.0, 30.0, 81.0, 46.0, 0.0, 46.0, 0.0, 30.0]" />
  </include>
</launch>