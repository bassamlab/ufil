<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false" description="Use the /clock topic as time source."/>
  <arg name="params_file" default="$(find-pkg-share ufil_pcl_map_builder)/config/default.yaml"
    description="Parameters loaded on top of the package defaults."/>
  <arg name="namespace" default="" description="Namespace of the node."/>

  <node pkg="ufil_pcl_map_builder" exec="ufil_pcl_map_builder_node"
    name="pcl_map_builder" namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share ufil_pcl_map_builder)/config/default.yaml"/>
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <!-- The "Publish point" tool of the Foxglove/Lichtblick 3D panel publishes /clicked_point. -->
    <remap from="clicked_point" to="/clicked_point"/>
  </node>
</launch>
