<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufil_tools</name>
  <version>0.2.0</version>
  <description>
    Meta package of the UFIL tools: the ufil_bag_manipulator and ufil_hdf_converter command line
    tools for recorded bags, and the ufil_pcl_map_builder node for landmark maps.
  </description>
  <maintainer email="schaefer@embedded.rwth-aachen.de">Simon Schäfer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ufil_bag_manipulator</exec_depend>
  <exec_depend>ufil_hdf_converter</exec_depend>
  <exec_depend>ufil_pcl_map_builder</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
