{
    "name": "ROS 2 Development Container",
    "dockerComposeFile": [
        "docker-compose.yml"
    ],
    "service": "dev",
    "runServices": [
        "dev"
    ],
    "remoteUser": "ufil",
    "workspaceFolder": "/home/ufil/ws",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "ranch-hand-robotics.rde-pack",
                "h5web.vscode-h5web"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/scripts/postCreate.sh"
}