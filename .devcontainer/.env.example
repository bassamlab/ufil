
# ── Volumes ───────────────────────────────────────────────────────────────────
# Host path to rosbag files; mounted read-only at /bags inside the container.
BAGS_DIR=~/tmp/bags

# ── ROS 2 ────────────────────────────────────────────────────────────────────
# Domain ID isolates ROS 2 traffic between concurrent devcontainer instances.
ROS_DOMAIN_ID=42

# ── Display ──────────────────────────────────────────────────────────────────
# X display socket forwarded into the dev container (Linux/XQuartz).
DISPLAY=unix:0
