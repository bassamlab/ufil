# Git tag or branch of lichtblick-suite/lichtblick to build.
LICHTBLICK_VERSION=v1.24.3

# Port exposed by the Lichtblick API service.
LICHTBLICK_API_PORT=8766

# Full URL the Lichtblick frontend uses to reach the API (baked in at build time).
# Must match LICHTBLICK_API_PORT above.
LICHTBLICK_API_URL=http://localhost:8766

# Default layout/datasource URL opened when Lichtblick loads.
DEFAULT_URI=/?ds=foxglove-websocket&ds.url=ws://localhost:8765&workspace=ufil
